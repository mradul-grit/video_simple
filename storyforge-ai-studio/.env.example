APP_ENV=development
APP_NAME=StoryForge AI Studio
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Signing secrets. Development uses built-in placeholders; any other APP_ENV refuses to start
# without 32+ character values. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=<generated value>
# STORAGE_SIGNING_SECRET=<generated value>

# Local data services
DATABASE_URL=postgresql+psycopg://storyforge:storyforge_dev_only@postgres:5432/storyforge
REDIS_URL=redis://redis:6379/0
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=/app/media_data
# Path to EDIT_MANIFEST.schema.json (Compose mounts it at /schema/). Empty = search the repo.
MANIFEST_SCHEMA_PATH=

# AI providers: mock is only for tests/demo; local providers require explicit setup.
TRANSCRIPTION_PROVIDER=mock
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
VISUAL_SEARCH_PROVIDER=openverse
IMAGE_GENERATION_PROVIDER=disabled
COMFYUI_BASE_URL=http://host.docker.internal:8188

# Optional object storage - never place these in the mobile app.
S3_ENDPOINT_URL=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional external provider keys (server-side only)
PIXABAY_API_KEY=
PEXELS_API_KEY=

# Upload / processing safeguards
MAX_UPLOAD_BYTES=1073741824
MAX_VIDEO_DURATION_SECONDS=900
SIGNED_URL_TTL_SECONDS=300
DEFAULT_MEDIA_RETENTION_DAYS=7
MAX_CONCURRENT_JOBS_PER_USER=1
